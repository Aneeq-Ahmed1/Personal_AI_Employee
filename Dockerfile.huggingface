FROM python:3.12-slim

WORKDIR /app

# Install dependencies
COPY silver_gold_platinum/skills/dashboard-api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY silver_gold_platinum/skills/dashboard-api/ .

# Expose port
EXPOSE 8000

# Run the application
CMD ["uvicorn", "api_server:app", "--host", "0.0.0.0", "--port", "8000"]
