# ===============================
# Personal AI Employee - Configuration
# ===============================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to GitHub!

# -------------------------------
# Gemini / AI Configuration
# -------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------
# OpenRouter API (Backup Provider)
# -------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# AI Provider Mode: auto (Gemini first, then OpenRouter) | gemini | openrouter
AI_PROVIDER=auto

# -------------------------------
# Gmail Configuration (Email Sending)
# -------------------------------
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# -------------------------------
# LinkedIn Configuration
# -------------------------------
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_PAGE_ID=
LINKEDIN_USE_PERSONAL_PROFILE=true

# -------------------------------
# WhatsApp Configuration (Twilio API)
# -------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=+14155238886

# -------------------------------
# Debugging & Logging
# -------------------------------
DEBUG=true
LOG_LEVEL=INFO

# -------------------------------
# Email Notifications (Approval System)
# -------------------------------
EMAIL_NOTIFICATIONS=true
NOTIFICATION_EMAIL=your_notification_email@gmail.com

# -------------------------------
# Odoo Configuration (Gold Tier)
# -------------------------------
ODOO_URL=http://localhost:8069
ODOO_DB=ai_employee
ODOO_USERNAME=ai@mycompany.com
ODOO_PASSWORD=your_odoo_password
ODOO_API_KEY=

# -------------------------------
# Browser Automation (Gold Tier)
# Just your regular login credentials - no API keys needed
# -------------------------------
FACEBOOK_EMAIL=your_facebook_email@example.com
FACEBOOK_PASSWORD=your_facebook_password

INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

TWITTER_USERNAME=your_twitter_username
TWITTER_PASSWORD=your_twitter_password

LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password

GMAIL_EMAIL=your_gmail@gmail.com
GMAIL_PASSWORD=your_gmail_app_password

WHATSAPP_PHONE=

# -------------------------------
# Frontend API Keys (Dashboard)
# -------------------------------
NEXT_PUBLIC_OPENROUTER_API_KEY=your_openrouter_api_key_here
